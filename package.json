{
  "name": "mc-command-helper",
  "displayName": "mc-command-helper",
  "description": "我的世界指令助手",
  "version": "0.0.1",
  "publisher": "maidang2233",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
  "onLanguage:mcfunction",
  "onLanguage:bc-mcfunction",
  "onLanguage:plaintext",
  "onStartupFinished"
],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mc-command-helper.helloWorld",
        "title": "Hello World"
      }
    ],
    "languages": [
      {
        "id": "bc-mcfunction",
        "extensions": [
          ".mcfunction"
        ],
        "aliases": [
          "MCFunction",
          "mcfunction"
        ]
      }
    ],
    "keybindings": [
      {
        "key": "down",
        "command": "mc-command-helper.nextSuggestion",
        "when": "suggestWidgetVisible && textInputFocus && (editorLangId == bc-mcfunction || editorLangId == mcfunction || editorLangId == plaintext)"
      },
      {
        "key": "up",
        "command": "mc-command-helper.prevSuggestion",
        "when": "suggestWidgetVisible && textInputFocus && (editorLangId == bc-mcfunction || editorLangId == mcfunction || editorLangId == plaintext)"
      },
      {
        "key": "ctrl+down",
        "command": "mc-command-helper.nextSuggestion",
        "when": "suggestWidgetVisible && textInputFocus && (editorLangId == bc-mcfunction || editorLangId == mcfunction || editorLangId == plaintext)"
      },
      {
        "key": "ctrl+up",
        "command": "mc-command-helper.prevSuggestion",
        "when": "suggestWidgetVisible && textInputFocus && (editorLangId == bc-mcfunction || editorLangId == mcfunction || editorLangId == plaintext)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.70.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}